---
import ScrollArtwork from "./ScrollArtwork.astro";
import { scrolls } from "../data/gallery";
import { withBase } from "../utils/paths";
---

<main class="gallery app-view" data-view-panel="gallery" aria-labelledby="gallery-title" hidden>
	<header class="gallery-intro">
		<p class="gallery-kicker"><span aria-hidden="true">藏</span> 应作如是 · 藏经</p>
		<h1 id="gallery-title">经卷画廊</h1>
		<p class="gallery-description">朱砂落于素纸，莲影浮在靛青。十二部经典，各有自己的开卷画面。择一卷，从导读进入原文。</p>
	</header>

	<div class="gallery-index">
		<h2>十二卷目录</h2>
		<span>{scrolls.length} 部经典</span>
	</div>

	<ul class="scroll-grid">
		{scrolls.map((scroll) => (
			<li>
				<a class="scroll-card" href={withBase(`/chat/gallery/${scroll.slug}/`)} data-scroll-link={scroll.code}>
					<div class="scroll-cover"><ScrollArtwork scroll={scroll} /></div>
					<div class="scroll-caption">
						<div>
							<h3 class="scroll-title">{scroll.title}</h3>
							<p class="scroll-meta">{scroll.code} · {scroll.size}</p>
						</div>
						<span class="open-scroll" aria-hidden="true">展开经卷 <span>↗</span></span>
					</div>
					<p class="scroll-theme">{scroll.material} · {scroll.theme}</p>
				</a>
			</li>
		))}
	</ul>

	<footer class="gallery-credit">
		展陈构思参考 <a href="https://rushiwowen.co/gallery" target="_blank" rel="noopener">如是我闻 · 经卷画廊 ↗</a>
	</footer>
</main>

<style>
	.gallery {
		--scroll-serif: var(--ask-ming-font);
		--scroll-brush: var(--ask-antique-font);
		width: min(1100px, 100%);
		margin: 0 auto;
		padding: clamp(40px, 6vw, 84px) clamp(6px, 2vw, 26px) 84px;
		-webkit-font-smoothing: antialiased;
	}

	.gallery[hidden] {
		display: none;
	}

	.gallery-intro {
		margin: 0 auto clamp(36px, 6vw, 68px);
		text-align: center;
	}

	.gallery-kicker {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		color: var(--ask-primary-dark);
		font: 14px var(--ask-antique-font);
		letter-spacing: 0.14em;
	}

	.gallery-kicker span {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border: 1px solid currentColor;
		border-radius: 3px;
		letter-spacing: 0;
	}

	.gallery h1 {
		margin: 16px 0;
		font: 400 clamp(42px, 6.4vw, 76px)/1.15 var(--ask-ming-font);
		letter-spacing: 0.09em;
		text-wrap: balance;
	}

	.gallery-description {
		max-width: 35em;
		margin: 0 auto;
		color: var(--ask-muted);
		font: 17px/1.8 var(--ask-antique-font);
		text-wrap: balance;
	}

	.gallery-index {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 18px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--ask-line);
		color: var(--ask-muted);
	}

	.gallery-index h2 {
		margin: 0;
		color: var(--ask-ink);
		font: 400 20px var(--ask-ming-font);
	}

	.gallery-index span {
		font: 13px var(--ask-antique-font);
	}

	.scroll-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(26px, 4vw, 50px) clamp(20px, 3vw, 34px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.scroll-card {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		text-decoration: none;
		text-align: start;
		cursor: pointer;
	}

	.scroll-cover {
		display: block;
		position: relative;
		overflow: hidden;
		aspect-ratio: 12 / 7;
		border-radius: 10px;
		outline: 1px solid rgb(0 0 0 / 0.1);
		outline-offset: -1px;
		transition: box-shadow 200ms ease, transform 200ms ease;
	}

	:global(.theme-dark) .scroll-cover {
		outline-color: rgb(255 255 255 / 0.1);
	}

	.scroll-caption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-top: 14px;
	}

	.scroll-title {
		display: block;
		margin: 0 0 5px;
		font: 400 clamp(19px, 2vw, 25px)/1.38 var(--ask-ming-font);
		text-wrap: balance;
	}

	.scroll-meta,
	.scroll-theme {
		display: block;
		margin: 0;
		color: var(--ask-muted);
		font: 14px/1.5 var(--ask-antique-font);
	}

	.scroll-theme {
		margin-top: 7px;
	}

	.open-scroll {
		color: var(--ask-primary-dark);
		font: 14px var(--ask-antique-font);
		white-space: nowrap;
	}

	.open-scroll span {
		display: inline-block;
		transition: transform 180ms ease;
	}

	.scroll-card:hover .scroll-cover {
		box-shadow: 0 12px 24px -15px var(--ask-muted);
		transform: translateY(-2px);
	}

	.scroll-card:hover .open-scroll span {
		transform: translate(2px, -2px);
	}

	.scroll-card:active .scroll-cover {
		transform: scale(0.96);
	}

	.gallery :is(button, a):focus-visible {
		outline: 2px solid var(--ask-primary);
		outline-offset: 4px;
	}

	.gallery-credit a {
		color: var(--ask-primary-dark);
		text-underline-offset: 4px;
	}

	.gallery-credit {
		margin-top: 54px;
		padding-top: 20px;
		border-top: 1px solid var(--ask-line);
		color: var(--ask-muted);
		font: 14px/1.6 var(--ask-antique-font);
		text-align: center;
	}

	@media (max-width: 680px) {
		.scroll-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-cover,
		.open-scroll span {
			transition: none;
		}
	}
</style>
